# Cloudflare Pages response headers (docs/design-docs/0003-hosting.md).
# scripts/preview.ts applies the built copy too, so `pnpm smoke` runs the pages under it.
# The Content-Security-Policy is added to the /* rule by scripts/build.ts (src/render/csp.ts):
# its style-src lists the hashes of the islands' <style> elements, so it is computed per build.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Demo recordings and posters: content-hashed names (scripts/sync-demos.mjs).
/demos/*
  Cache-Control: public, max-age=31536000, immutable

# Files that aren't HTML don't get the site's Content-Security-Policy (`!` detaches a header a
# more general rule set): it protects nothing in them, and browsers show them with built-in
# viewers whose inline styles it would block (Chrome's XML viewer on the sitemap, the text
# viewer's line wrapping). The other /* headers stay.
/sitemap.xml
  ! Content-Security-Policy
/robots.txt
  ! Content-Security-Policy

# Files for agents (src/content/llms.ts). Cached like the HTML pages (Cloudflare's default).
/llms.txt
  Content-Type: text/plain; charset=utf-8
  ! Content-Security-Policy
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  ! Content-Security-Policy
/*.md
  Content-Type: text/markdown; charset=utf-8
  ! Content-Security-Policy
